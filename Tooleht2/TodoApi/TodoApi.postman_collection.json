{
  "info": {
    "name": "TodoApi – tööleht 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5102"
    },
    {
      "key": "todoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Lisa ülesanne",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/todoitems",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Õpi C# keelt\", \"isComplete\": false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"todoId\", pm.response.json().id);",
              "pm.test(\"Secret puudub\", () => pm.expect(pm.response.json()).not.to.have.property(\"secret\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Kõik ülesanded",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/todoitems"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Üks ülesanne",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/todoitems/{{todoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Märgi tehtuks",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/todoitems/{{todoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"id\": {{todoId}}, \"name\": \"Õpi C# keelt\", \"isComplete\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Kontrolli muudatust",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/todoitems/{{todoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Ülesanne tehtud\", () => pm.expect(pm.response.json().isComplete).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Kustuta ülesanne",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/todoitems/{{todoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Kustutatu puudub",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/todoitems/{{todoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Vigane nimi",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/todoitems",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"\", \"isComplete\": false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
