@model MovieGenreViewModel
@{ ViewData["Title"] = "Filmid"; }
<h1>Filmide andmebaas</h1>
<p><a asp-action="Create">Lisa uus film</a></p>
<form asp-action="Index" method="get">
    <label asp-for="MovieGenre">Žanr</label>
    <select asp-for="MovieGenre" asp-items="Model.Genres"><option value="">Kõik</option></select>
    <label asp-for="SearchString">Pealkiri</label>
    <input asp-for="SearchString" />
    <button type="submit">Otsi</button>
    <a asp-action="Index">Tühjenda</a>
</form>
@if (Model.Movies.Count == 0) { <p>Ühtegi filmi ei leitud.</p> }
else
{
<table>
    <thead><tr><th>Pealkiri</th><th>Ilmumiskuupäev</th><th>Žanr</th><th>Hind</th><th>Vanusepiirang</th><th>Tegevused</th></tr></thead>
    <tbody>
    @foreach (var movie in Model.Movies)
    {
        <tr>
            <td>@movie.Title</td><td>@movie.ReleaseDate.ToString("yyyy-MM-dd")</td><td>@movie.Genre</td><td>@movie.Price.ToString("0.00") €</td><td>@movie.Rating</td>
            <td><a asp-action="Details" asp-route-id="@movie.Id">Vaata</a> · <a asp-action="Edit" asp-route-id="@movie.Id">Muuda</a> · <a asp-action="Delete" asp-route-id="@movie.Id">Kustuta</a></td>
        </tr>
    }
    </tbody>
</table>
}
